{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sunodown-vibes-renderer",
  "main": "worker.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "containers": [
    {
      "class_name": "RendererContainer",
      "image": "./Dockerfile",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      {"name": "AI_RENDERER", "class_name": "RendererContainer"}
    ]
  },
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["RendererContainer"]}
  ],
  "observability": {"enabled": true}
}
