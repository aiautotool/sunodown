{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sunodown-picai",
  "account_id": "2de679b502c90e736abad750fd0415f7",
  "main": "dist/server/worker-picai.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js",
        "**/*.mjs"
      ]
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "picai.online/*",
      "zone_name": "picai.online"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "cp worker-picai.js dist/server/worker-picai.js"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MUSIC_USERS",
        "class_name": "MusicUserStore"
      },
      {
        "name": "MUSIC_DIRECTORY",
        "class_name": "PublicMusicDirectory"
      }
    ]
  },
  "migrations": [
    {
      "tag": "music-v1",
      "new_sqlite_classes": [
        "MusicUserStore"
      ]
    },
    {
      "tag": "music-v2",
      "new_sqlite_classes": [
        "PublicMusicDirectory"
      ]
    }
  ]
}
